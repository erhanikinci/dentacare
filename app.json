{
  "expo": {
    "name": "DentaCare Türkiye",
    "slug": "dentacare-premium-tr",
    "scheme": "dentacaretr",
    "version": "3.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#EAF8FF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dentacare.turkiye",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "tr_TR",
        "CFBundleLocalizations": [
          "tr"
        ]
      }
    },
    "android": {
      "package": "com.dentacare.turkiye",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EAF8FF"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "name": "DentaCare Türkiye",
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EAF8FF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 190,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "locales": {
      "tr": "./locales/tr.json"
    }
  }
}
